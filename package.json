{
  "name": "matchday-overlay",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:server": "tsx watch src/server/main.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "vite build && tsx src/server/main.ts",
    "serve": "tsx src/server/main.ts",
    "test": "vitest run",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "exe": "node scripts/build-exe.mjs",
    "companion": "npm --prefix companion-module install --no-audit --no-fund && npm --prefix companion-module run package"
  },
  "dependencies": {
    "@fastify/static": "^10.1.5",
    "@fastify/websocket": "^11.3.3",
    "@fontsource-variable/anybody": "^5.3.0",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "fastify": "^5.12.5",
    "gsap": "^3.15.0",
    "qrcode-generator": "^2.0.4",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.4",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "pe-library": "^2.0.1",
    "postject": "1.0.0-alpha.6",
    "resedit": "^3.1.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "ws": "^8.22.0"
  }
}
